# Copy this file to .env and change the passwords before exposing the server.
DB_NAME=l2jmobiusinterlude
DB_USER=l2j
DB_PASSWORD=replace-with-a-strong-password
DB_ROOT_PASSWORD=replace-with-another-strong-password

# IP or DNS name that Lineage 2 clients use to reach this Linux machine.
# Replace with the address clients use to reach this Linux host.
SERVER_ADDRESS=192.168.1.50

# JVM heap sizes. Suffixes such as m and g are accepted by Java.
LOGIN_JAVA_XMS=128m
LOGIN_JAVA_XMX=256m
GAME_JAVA_XMS=2g
GAME_JAVA_XMX=4g
